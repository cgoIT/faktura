# faktura – Konfiguration für docker compose.
# Kopieren nach .env (wird nicht committet) und anpassen:   cp .env.example .env
# Alle Werte hier gelten im Container. Nicht gesetzte Werte nehmen die Standards der Anwendung (application.yml).
# Eine Variable nie leer setzen ("NAME="): ein leerer Wert überschreibt den Standard. Optionales bleibt auskommentiert.
# Ausführlich: docs/betrieb.md

# ---------------------------------------------------------------------------------------------------------------------
# 1. Anmeldung (Pflicht)
# ---------------------------------------------------------------------------------------------------------------------
# FORM  = Anmeldeseite mit Benutzername und Passwort (empfohlen, wenn kein Reverse Proxy mit Anmeldung davor steht)
# NONE  = keine Anmeldung; nur sicher hinter einem Proxy, der jeden Zugriff authentifiziert
# PROXY_HEADER / PROXY_HEADER_ADMIN_FORM = Benutzername aus einem Header des Proxys (siehe docs/betrieb.md)
SECURITY_MODE=FORM
# Administrator, der beim ersten Start angelegt wird. MUSS ausgefüllt werden (Passwort mindestens 12 Zeichen),
# sonst startet die Anwendung im Modus FORM bewusst nicht.
SECURITY_ADMIN_USER=admin
SECURITY_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------------------------------------------------
# 2. Port und Daten
# ---------------------------------------------------------------------------------------------------------------------
# Port auf dem Host (gebunden an 127.0.0.1) und Verzeichnis für Datenbank, Archiv und Backups.
# Das Verzeichnis muss für den Container-Nutzer beschreibbar sein:  chown 10001:10001 ./data
FAKTURA_PORT=8080
FAKTURA_DATA=./data

# ---------------------------------------------------------------------------------------------------------------------
# 3. Backup (nächtlich, in FAKTURA_DATA/backup – zusätzlich an einen anderen Ort kopieren)
# ---------------------------------------------------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_CRON=0 30 2 * * *
BACKUP_KEEP_COUNT=14

# ---------------------------------------------------------------------------------------------------------------------
# 4. Optional: Logo für Rechnungen, Angebote und Mahnungen (PNG, JPEG oder GIF; Datei im Datenverzeichnis, siehe docs/handbuch.md)
#    und Adresse der Anwendung (Link in der Hinweis-Mail), z. B. https://faktura.example.org/
# ---------------------------------------------------------------------------------------------------------------------
#LOGO_PATH=/data/logo.png
#BASE_URL=

# ---------------------------------------------------------------------------------------------------------------------
# 5. Optional: Belege per Mail senden und Hinweis-Mail (aus, solange MAIL_ENABLED nicht true ist)
#    Zugangsdaten nur hier eintragen, nie ins Repository.
# ---------------------------------------------------------------------------------------------------------------------
#MAIL_ENABLED=true
#MAIL_HOST=smtp.example.org
#MAIL_PORT=587
#MAIL_USER=
#MAIL_PASSWORD=
#MAIL_FROM=rechnung@example.org
#MAIL_BCC=
# Port 465: MAIL_SSL=true und MAIL_STARTTLS=false
#MAIL_STARTTLS=true
#MAIL_SSL=false

# ---------------------------------------------------------------------------------------------------------------------
# 6. Optional: Export-Ordner für finalisierte PDFs (z. B. von einem Dokumentenarchiv überwacht)
#    Zusätzlich die Zeile "/export" in docker-compose.yml einkommentieren.
# ---------------------------------------------------------------------------------------------------------------------
#EXPORT_PATH=/export
#FAKTURA_EXPORT=./export

# ---------------------------------------------------------------------------------------------------------------------
# 7. Optional: Anmeldung über Header eines Reverse Proxys (nur mit SECURITY_MODE=PROXY_HEADER*)
# ---------------------------------------------------------------------------------------------------------------------
#SECURITY_HEADER=X-Forwarded-User
# Header mit dem Anzeigenamen (Pangolin: Remote-Name)
#SECURITY_NAME_HEADER=
# Adressen oder Netze, von denen der Header akzeptiert wird; im Container das Docker-Netz des Proxys
#SECURITY_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# ---------------------------------------------------------------------------------------------------------------------
# 8. Optional: PostgreSQL statt SQLite (Standard: SQLite-Datei in FAKTURA_DATA)
# ---------------------------------------------------------------------------------------------------------------------
#DB_URL=jdbc:postgresql://db:5432/faktura
#DB_USER=
#DB_PASSWORD=
#DB_POOL_SIZE=5
